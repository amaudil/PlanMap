<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Planealo Aquí - Experiencias Compartidas</title>
    <!-- Tipografía moderna -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Leaflet.js para el mapa base -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    
    <style>
        :root {
            --bg-dark: #0A0C0B;
            --card-dark: #161A18;
            --card-border: rgba(255, 255, 255, 0.08);
            --text-white: #FFFFFF;
            --text-gray: #8A9590;
            --accent-neon: #CCFF00;
            --accent-neon-hover: #B5E600;
            --accent-whatsapp: #25D366;
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
        
        body {
            background-color: #030404;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100dvh;
            width: 100vw;
            color: var(--text-white);
            overflow: hidden;
        }

        #app {
            background-color: var(--bg-dark);
            width: 100%;
            max-width: 410px;
            height: 100dvh;
            max-height: 850px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
        }

        @media (min-width: 480px) {
            #app {
                border-radius: 44px;
                height: 840px;
                border: 2px solid rgba(255,255,255,0.08);
            }
        }

        .view {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            display: none;
            flex-direction: column;
            background-color: var(--bg-dark);
            opacity: 0;
            transform: scale(0.98);
            transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 1;
        }
        .view.active { display: flex; opacity: 1; transform: scale(1); z-index: 5; }

        /* ========================================
           VISTA 0: BIENVENIDA
           ======================================== */
        #view-welcome {
            padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)) 20px;
            justify-content: space-between;
            background: linear-gradient(180deg, #111513 0%, #0A0C0B 100%);
            overflow-y: auto;
        }

        .welcome-hero-card {
            width: 100%;
            height: 300px;
            min-height: 250px;
            background: var(--card-dark);
            border-radius: 28px;
            overflow: hidden;
            position: relative;
            border: 1px solid var(--card-border);
            box-shadow: 0 16px 32px rgba(0,0,0,0.4);
            flex-shrink: 0;
        }

        .welcome-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.85) contrast(1.05);
        }

        .hero-gradient-overlay {
            position: absolute;
            bottom: 0; left: 0; width: 100%; height: 50%;
            background: linear-gradient(to top, rgba(22, 26, 24, 0.9), transparent);
        }

        .welcome-title {
            font-size: clamp(1.8rem, 5vw, 2.2rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.6px;
            margin-top: 16px;
            color: var(--text-white);
        }

        .welcome-subtitle {
            font-size: 0.9rem;
            color: var(--text-gray);
            margin-top: 8px;
            line-height: 1.4;
        }

        .btn-neon {
            background-color: var(--accent-neon);
            color: #0A0C0B;
            width: 100%;
            padding: 16px;
            border-radius: 22px;
            font-size: 1.05rem;
            font-weight: 800;
            border: none;
            cursor: pointer;
            text-align: center;
            box-shadow: 0 10px 30px rgba(204, 255, 0, 0.25);
            transition: transform 0.15s ease, background-color 0.2s ease;
        }
        .btn-neon:active { transform: scale(0.97); background-color: var(--accent-neon-hover); }

        .btn-whatsapp {
            background-color: var(--accent-whatsapp);
            color: #FFFFFF;
            width: 100%;
            padding: 14px;
            border-radius: 18px;
            font-size: 0.95rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            text-align: center;
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
            transition: transform 0.15s ease;
        }
        .btn-whatsapp:active { transform: scale(0.97); }

        /* ========================================
           VISTA 1: MAPA VIVO Y CENTRO DE MANDO
           ======================================== */
        #map-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 1;
            filter: invert(100%) hue-rotate(180deg) brightness(88%) contrast(92%);
        }

        .map-overlay-top {
            position: absolute;
            top: 0; left: 0; width: 100%;
            padding: max(20px, env(safe-area-inset-top)) 20px 20px 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 10;
            pointer-events: none;
        }
        .map-overlay-top > * { pointer-events: auto; }

        .top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .brand-pill-dark {
            background: rgba(22, 26, 24, 0.85);
            backdrop-filter: blur(16px);
            padding: 10px 18px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1rem;
            color: var(--text-white);
            border: 1px solid var(--card-border);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }

        /* Píldora flotante del Host para ver el plan activo sin salir del mapa */
        .active-plan-pill {
            background: rgba(22, 26, 24, 0.9);
            backdrop-filter: blur(16px);
            padding: 12px 18px;
            border-radius: 20px;
            border: 1px solid var(--accent-neon);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            transition: transform 0.15s ease;
        }
        .active-plan-pill:active { transform: scale(0.98); }

        .icon-btn-dark {
            width: 46px; height: 46px;
            background: rgba(22, 26, 24, 0.85);
            backdrop-filter: blur(16px);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            border: 1px solid var(--card-border);
            color: var(--text-white);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            flex-shrink: 0;
        }

        .map-overlay-bottom {
            position: absolute;
            bottom: max(25px, env(safe-area-inset-bottom)); left: 0; width: 100%;
            padding: 0 20px;
            z-index: 10;
        }

        .action-pill-neon {
            background: var(--accent-neon);
            color: #0A0C0B;
            border-radius: 32px;
            padding: 16px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 14px 35px rgba(204, 255, 0, 0.35);
            font-weight: 800;
            font-size: 1.05rem;
            transition: transform 0.15s ease;
        }
        .action-pill-neon:active { transform: scale(0.97); }
        .action-arrow-dark {
            width: 36px; height: 36px; background: rgba(10, 12, 11, 0.12); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 1rem;
        }

        /* ========================================
           VISTAS INTERNAS
           ======================================== */
        .solid-view {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)) 20px;
            background: var(--bg-dark);
            z-index: 20;
            display: none;
            flex-direction: column;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            transform: translateY(15px);
            transition: transform 0.25s ease, opacity 0.25s ease;
            opacity: 0;
        }
        .solid-view.active { display: flex; transform: translateY(0); opacity: 1; }

        h1 { font-size: 1.7rem; font-weight: 800; color: var(--text-white); margin-bottom: 4px; letter-spacing: -0.5px; }
        p.subtitle { font-size: 0.9rem; color: var(--text-gray); margin-bottom: 20px; }

        .card-dark {
            background: var(--card-dark);
            border-radius: 24px;
            padding: 20px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            margin-bottom: 14px;
            border: 1px solid var(--card-border);
        }

        .input-dark {
            width: 100%; padding: 16px;
            border-radius: 18px;
            border: 1px solid var(--card-border);
            background: var(--card-dark);
            color: var(--text-white);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .input-dark:focus { border-color: var(--accent-neon); }

        /* Selector de Vibes */
        .vibe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .vibe-option-dark {
            background: var(--card-dark);
            border: 2px solid var(--card-border);
            border-radius: 20px;
            padding: 16px 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .vibe-option-dark.selected { border-color: var(--accent-neon); background: rgba(204, 255, 0, 0.06); }
        .vibe-emoji { font-size: 2rem; margin-bottom: 6px; }
        .vibe-name { font-weight: 700; font-size: 0.9rem; color: var(--text-white); }

        /* Postal Dark Pro */
        .postal-card-dark {
            background: linear-gradient(135deg, #161A18 0%, #0A0C0B 100%);
            color: var(--text-white);
            padding: 24px;
            border-radius: 28px;
            text-align: center;
            margin-bottom: 16px;
            border: 1px solid var(--card-border);
            box-shadow: 0 16px 35px rgba(0,0,0,0.5);
        }
        .postal-img-placeholder {
            width: 100%; height: 150px; background: rgba(255,255,255,0.03); border-radius: 18px; display: flex; align-items: center; justify-content: center; font-size: 3rem; margin-bottom: 14px;
            border: 1px solid var(--card-border);
        }

        .view-footer {
            margin-top: auto;
            padding-top: 10px;
        }
    </style>
</head>
<body>

<div id="app">
    <!-- ========================================
         VISTA 0: BIENVENIDA
         ======================================== -->
    <div id="view-welcome" class="view">
        <div>
            <div class="welcome-hero-card">
                <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=800&q=80" alt="Experiencia compartida" class="welcome-hero-img">
                <div class="hero-gradient-overlay"></div>
            </div>
            <h1 class="welcome-title">Conecta sin ruido, vive el momento.</h1>
            <p class="welcome-subtitle">Organiza planes al instante, reúne a tu gente y conserva recuerdos significativos.</p>
        </div>
        
        <div style="margin-top: 20px;">
            <button class="btn-neon" onclick="completeOnboarding()">Comenzar</button>
            <p style="text-align: center; font-size: 0.85rem; color: var(--text-gray); margin-top: 12px;">¿Ya tienes cuenta? <span style="color: var(--text-white); font-weight: 700; cursor: pointer;">Iniciar sesión</span></p>
        </div>
    </div>

    <!-- ========================================
         VISTA 1: MAPA VIVO Y CENTRO DE MANDO
         ======================================== -->
    <div id="view-map" class="view">
        <div id="map-container"></div>

        <div class="map-overlay-top">
            <div class="top-row">
                <div class="brand-pill-dark">Planealo Aquí ⚡</div>
                <button class="icon-btn-dark" onclick="goToMemory()">🖼️</button>
            </div>
            <!-- Píldora flotante para que el Host supervise su plan activo en cualquier momento -->
            <div class="active-plan-pill" id="map-plan-pill" onclick="openActivePlan()" style="display: none;">
                <div>
                    <span style="font-size: 0.75rem; color: var(--accent-neon); font-weight: 800; display: block;">⚡ PLAN ACTIVO</span>
                    <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-white);" id="map-pill-title">Café en Casco</span>
                </div>
                <span style="font-size: 0.85rem; background: rgba(204,255,0,0.15); color: var(--accent-neon); padding: 4px 10px; border-radius: 12px; font-weight: 800;" id="map-pill-count">4 en camino →</span>
            </div>
        </div>

        <div class="map-overlay-bottom">
            <div class="action-pill-neon" onclick="goToCreatePlan()">
                <span>¿Cuál es el plan hoy?</span>
                <div class="action-arrow-dark">→</div>
            </div>
        </div>
    </div>

    <!-- ========================================
         VISTA 2: CREAR PLAN
         ======================================== -->
    <div id="view-create" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Cancelar</h3>
            <span style="font-weight: 800; color: var(--accent-neon); font-size: 0.9rem;">Paso 1 de 2</span>
        </div>
        <h1>Nuevo Plan</h1>
        <p class="subtitle">Define la vibra y el propósito del encuentro.</p>

        <div style="margin-bottom: 16px;">
            <label style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 6px; color: var(--text-white);">¿Qué van a hacer?</label>
            <input type="text" id="plan-title" class="input-dark" value="Café y estudio en Casco Antiguo">
        </div>

        <label style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 10px; color: var(--text-white);">Selecciona la Vibe</label>
        <div class="vibe-grid">
            <div class="vibe-option-dark selected" onclick="selectVibe(this, 'Chill', '☕')">
                <div class="vibe-emoji">☕</div>
                <div class="vibe-name">Chill</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Energía', '👟')">
                <div class="vibe-emoji">👟</div>
                <div class="vibe-name">Energía</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Aire libre', '🌳')">
                <div class="vibe-emoji">🌳</div>
                <div class="vibe-name">Aire libre</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Nocturno', '🌙')">
                <div class="vibe-emoji">🌙</div>
                <div class="vibe-name">Nocturno</div>
            </div>
        </div>

        <div class="view-footer">
            <button class="btn-neon" onclick="generateInvite()">Armar enlace de invitación</button>
        </div>
    </div>

    <!-- ========================================
         VISTA 3: SALA DE INVITACIÓN / CENTRO DE CONTROL
         ======================================== -->
    <div id="view-invite" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Volver al Mapa</h3>
            <span style="font-size: 0.85rem; background: rgba(204,255,0,0.1); color: var(--accent-neon); padding: 6px 12px; border-radius: 12px; font-weight: 800;">Plan Activo</span>
        </div>
        <h1>¡Plan listo para rodar! 🔥</h1>
        <p class="subtitle" id="invite-subtitle">Vibe: ☕ Chill</p>

        <div class="card-dark" style="text-align: center; border: 2px dashed var(--accent-neon);">
            <p style="font-size: 0.85rem; color: var(--text-gray); margin-bottom: 6px;">Enlace rápido para compartir</p>
            <h3 id="invite-url-text" style="color: var(--accent-neon); margin-bottom: 12px; font-size: 0.9rem; word-break: break-all;">planealo-aqui.netlify.app/?t=Plan</h3>
            
            <div style="display: flex; gap: 8px;">
                <button class="input-dark" style="padding: 10px; font-size: 0.85rem; text-align: center; cursor: pointer; background: var(--bg-dark);" onclick="copyInviteLink()">Copiar Enlace</button>
                <button class="btn-whatsapp" style="padding: 10px; font-size: 0.85rem;" onclick="shareOnWhatsApp()">WhatsApp</button>
            </div>
        </div>

        <div class="card-dark">
            <h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--text-white);" id="participants-title">Amigos en camino (3)</h4>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                    <span style="color: var(--text-white);">👤 Tú <span style="background: rgba(204,255,0,0.15); color: var(--accent-neon); padding: 2px 6px; border-radius: 6px; font-size: 0.7rem;">Host</span></span>
                    <span style="color: #ff6b6b;">📍 En el punto</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                    <span style="color: var(--text-gray);">👩‍💻 Sofía R.</span>
                    <span style="color: var(--accent-neon);" id="status-sofia">🚀 En camino (5 min)</span>
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                    <span style="color: var(--text-gray);">🧑‍🎨 Mateo V.</span>
                    <span style="color: var(--accent-neon);">🚀 En camino (8 min)</span>
                </div>
            </div>
        </div>

        <div class="view-footer">
            <button class="btn-neon" onclick="joinAsGuest()" id="join-btn" style="margin-bottom: 10px; display: none;">¡Voy en camino! 🏃‍♂️</button>
            <button class="btn-neon" onclick="switchView('view-map')">Ver Mapa en Vivo</button>
        </div>
    </div>

    <!-- ========================================
         VISTA 4: RECUERDO / POSTAL
         ======================================== -->
    <div id="view-memory" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Volver al Mapa</h3>
            <span style="font-weight: 800; color: var(--text-white);">Recuerdo Colectivo</span>
        </div>
        
        <div class="postal-card-dark">
            <div class="postal-img-placeholder">🌅</div>
            <h3 style="margin-bottom: 4px; font-size: 1.3rem;" id="postal-title">Café y Estudio en Casco</h3>
            <p style="font-size: 0.85rem; color: var(--text-gray);">Panamá · 6 de Noviembre, 2026</p>
        </div>

        <div class="card-dark">
            <p style="font-size: 0.9rem; font-style: italic; text-align: center; color: var(--text-gray);">“Un espacio libre de ruido para conectar de verdad.”</p>
        </div>

        <div class="view-footer" style="display: flex; gap: 10px;">
            <button class="input-dark" style="flex: 1; text-align: center; cursor: pointer; font-weight: 700; background: var(--card-dark);" onclick="alert('¡Postal guardada!')">Guardar</button>
            <button class="btn-neon" style="flex: 1; margin-top: 0;" onclick="alert('¡Abriendo menú para compartir!')">Compartir</button>
        </div>
    </div>
</div>

<script>
    let map = null;
    let selectedVibeText = '☕ Chill';
    let fullInviteUrl = '';
    let currentPlanData = { title: 'Café y estudio en Casco Antiguo', vibe: '☕ Chill' };

    window.addEventListener('DOMContentLoaded', () => {
        // Inicializar mapa de Leaflet
        map = L.map('map-container', { zoomControl: false }).setView([8.9824, -79.5199], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        L.marker([8.9824, -79.5199]).addTo(map)
            .bindPopup('Tú estás aquí ✨');

        // GESTIÓN INTELIGENTE DE ENLACES Y MEMORIA DE PLAN ACTIVO
        const urlParams = new URLSearchParams(window.location.search);
        const planTitleParam = urlParams.get('t');
        const planVibeParam = urlParams.get('v');
        const seenWelcome = localStorage.getItem('planealo_onboarding_seen');
        const savedActivePlan = localStorage.getItem('planealo_active_plan');

        if (planTitleParam) {
            // El usuario entra como INVITADO mediante enlace
            const decodedTitle = decodeURIComponent(planTitleParam);
            const decodedVibe = planVibeParam ? decodeURIComponent(planVibeParam) : '☕ Chill';

            currentPlanData = { title: decodedTitle, vibe: decodedVibe };
            updateInviteScreen();
            
            document.getElementById('join-btn').style.display = 'block';
            switchView('view-invite');
        } else {
            // Si hay un plan activo guardado en este navegador (como Host), mostrar la píldora en el mapa
            if (savedActivePlan) {
                currentPlanData = JSON.parse(savedActivePlan);
                showMapPlanPill(true);
            }

            if (seenWelcome) {
                switchView('view-map');
            } else {
                switchView('view-welcome');
            }
        }
    });

    function switchView(viewId) {
        document.querySelectorAll('.view, .solid-view').forEach(v => v.classList.remove('active'));
        const target = document.getElementById(viewId);
        if (target) {
            target.classList.add('active');
        }

        if (viewId === 'view-map') {
            setTimeout(() => { if(map) map.invalidateSize(); }, 300);
        }
    }

    function completeOnboarding() {
        localStorage.setItem('planealo_onboarding_seen', 'true');
        switchView('view-map');
    }

    function goToCreatePlan() {
        switchView('view-create');
    }

    function selectVibe(element, vibeName, emoji) {
        document.querySelectorAll('.vibe-option-dark').forEach(el => el.classList.remove('selected'));
        element.classList.add('selected');
        selectedVibeText = `${emoji} ${vibeName}`;
    }

    function generateInvite() {
        const title = document.getElementById('plan-title').value || 'Plan en grupo';
        currentPlanData = { title: title, vibe: selectedVibeText };

        // Guardar como plan activo en localStorage para que el Host lo tenga persistente
        localStorage.setItem('planealo_active_plan', JSON.stringify(currentPlanData));

        updateInviteScreen();
        showMapPlanPill(true);

        // Construir el enlace limpio con el dominio actual
        const domain = window.location.host || 'planealo-aqui.netlify.app';
        const encodedTitle = encodeURIComponent(title);
        const encodedVibe = encodeURIComponent(selectedVibeText);
        
        fullInviteUrl = `https://${domain}/?t=${encodedTitle}&v=${encodedVibe}`;
        document.getElementById('invite-url-text').innerText = fullInviteUrl;
        
        switchView('view-invite');
    }

    function updateInviteScreen() {
        document.getElementById('invite-subtitle').innerText = `Vibe: ${currentPlanData.vibe} · ${currentPlanData.title}`;
        document.getElementById('postal-title').innerText = currentPlanData.title;
    }

    function showMapPlanPill(show) {
        const pill = document.getElementById('map-plan-pill');
        if (show) {
            document.getElementById('map-pill-title').innerText = currentPlanData.title;
            pill.style.display = 'flex';
        } else {
            pill.style.display = 'none';
        }
    }

    function openActivePlan() {
        // Al tocar la píldora en el mapa, el Host accede directo al panel de control sin recrear nada
        updateInviteScreen();
        document.getElementById('join-btn').style.display = 'none'; // El host no se auto-invita
        switchView('view-invite');
    }

    function joinAsGuest() {
        document.getElementById('status-sofia').innerText = '✅ ¡Ya vas en camino!';
        document.getElementById('status-sofia').style.color = '#CCFF00';
        document.getElementById('join-btn').innerText = '¡Conectado al Plan! 🚀';
        document.getElementById('join-btn').disabled = true;
        document.getElementById('join-btn').style.opacity = '0.7';
        document.getElementById('participants-title').innerText = 'Amigos en camino (4)';
    }

    function copyInviteLink() {
        navigator.clipboard.writeText(fullInviteUrl).then(() => {
            alert('¡Enlace copiado al portapapeles!');
        }).catch(() => {
            alert('Enlace listo.');
        });
    }

    function shareOnWhatsApp() {
        const message = encodeURIComponent(`¡Únete a Planealo Aquí! Coordinemos el punto de encuentro aquí: ${fullInviteUrl}`);
        window.open(`https://api.whatsapp.com/send?text=${message}`, '_blank');
    }

    function goToMemory() {
        switchView('view-memory');
    }
</script>

</body>
</html>