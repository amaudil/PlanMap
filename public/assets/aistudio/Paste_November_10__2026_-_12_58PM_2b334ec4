</div>

<script>
    let map = null;
    let selectedVibeText = '☕ Chill';
    let fullInviteUrl = '';
    let currentPlanData = { title: 'Café y estudio', vibe: '☕ Chill' };
    let participantCount = 3;
    let currentStyle = 'postal';

    // Geofencing Real Engine & Selector Dinámico
    const GEOFENCE_RADIUS_METERS = 50;
    let targetCoords = [8.9824, -79.5199]; // Casco Antiguo predeterminado
    let userCoords = [8.9808, -79.5212]; // Distancia inicial
    let isSimulatedArrival = false;
    let hasCelebratedArrival = false;
    let isSelectingLocationMode = false;
    let geofenceCircle = null;
    let targetMarker = null;
    let userMarker = null;
    let routePolyline = null;
    let gpsWatcherId = null;

    function calculateHaversine(lat1, lon1, lat2, lon2) {
        const R = 6371000;
        const toRad = deg => (deg * Math.PI) / 180;
        const dLat = toRad(lat2 - lat1);
        const dLon = toRad(lon2 - lon1);
        const a =
            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
            Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
            Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return Math.round(R * c);
    }

    function formatDistanceETA(distanceMeters) {
        const isInside = distanceMeters <= GEOFENCE_RADIUS_METERS;
        const distanceLabel = distanceMeters >= 1000
            ? `${(distanceMeters / 1000).toFixed(1)} km`
            : `${distanceMeters} m`;
        const walkingMinutes = Math.max(1, Math.round(distanceMeters / 80));
        const etaLabel = isInside ? 'En el punto' : `~${walkingMinutes} min a pie`;
        return { distanceLabel, etaLabel, isInside };
    }

    function setTargetLocation(lat, lng, centerMap = false) {
        targetCoords = [lat, lng];
        if (geofenceCircle) {
            geofenceCircle.setLatLng(targetCoords);
        }
        if (targetMarker) {
            targetMarker.setLatLng(targetCoords);
        }
        if (routePolyline) {
            routePolyline.setLatLngs([userCoords, targetCoords]);
        }
        if (centerMap && map) {
            map.panTo(targetCoords, { animate: true });
        }
        updateGeofenceTelemetry(userCoords);
        updateLocationLabels();
    }

    function updateLocationLabels() {
        const latStr = Number(targetCoords[0]).toFixed(4);
        const lngStr = Number(targetCoords[1]).toFixed(4);
        const badge = document.getElementById('create-coords-badge');
        const pill = document.getElementById('selected-coords-pill');
        if (badge) badge.innerText = `${latStr}, ${lngStr}`;
        if (pill) pill.innerText = `📍 ${latStr}, ${lngStr}`;
    }

    function startPickingLocationOnMap() {
        isSelectingLocationMode = true;
        const radar = document.getElementById('geofence-radar-pill');
        const planPill = document.getElementById('map-plan-pill');
        const banner = document.getElementById('map-selection-banner');
        if (radar) radar.style.display = 'none';
        if (planPill) planPill.style.display = 'none';
        if (banner) banner.style.display = 'flex';
        updateLocationLabels();
        switchView('view-map');
        if (map) {
            setTimeout(() => {
                map.invalidateSize();
                map.panTo(targetCoords, { animate: true });
            }, 200);
        }
    }

    function confirmLocationSelection() {
        isSelectingLocationMode = false;
        const radar = document.getElementById('geofence-radar-pill');
        const banner = document.getElementById('map-selection-banner');
        if (banner) banner.style.display = 'none';
        if (radar) radar.style.display = 'flex';
        if (currentPlanData && localStorage.getItem('planealo_active_plan')) {
            showMapPlanPill(true);
        }
        updateLocationLabels();
        switchView('view-create');
    }

    function cancelLocationSelection() {
        isSelectingLocationMode = false;
        const radar = document.getElementById('geofence-radar-pill');
        const banner = document.getElementById('map-selection-banner');
        if (banner) banner.style.display = 'none';
        if (radar) radar.style.display = 'flex';
        if (currentPlanData && localStorage.getItem('planealo_active_plan')) {
            showMapPlanPill(true);
        }
        switchView('view-create');
    }

    function useCurrentLocationAsTarget() {
        if ('geolocation' in navigator) {
            navigator.geolocation.getCurrentPosition(
                pos => {
                    setTargetLocation(pos.coords.latitude, pos.coords.longitude, true);
                    alert(`📍 ¡Punto fijado en tus coordenadas GPS actuales! (${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)})`);
                },
                () => {
                    setTargetLocation(userCoords[0], userCoords[1], true);
                    alert('📍 Punto fijado en la posición de radar.');
                },
                { enableHighAccuracy: true, timeout: 8000 }
            );
        } else {
            setTargetLocation(userCoords[0], userCoords[1], true);
        }
    }

    function updateGeofenceTelemetry(coords) {
        userCoords = coords;
        const dist = calculateHaversine(userCoords[0], userCoords[1], targetCoords[0], targetCoords[1]);
        const { distanceLabel, etaLabel, isInside } = formatDistanceETA(dist);

        const radarPill = document.getElementById('geofence-radar-pill');
        const radarTitle = document.getElementById('radar-title');
        const radarSubtitle = document.getElementById('radar-subtitle');
        const hostStatus = document.getElementById('host-geofence-status');

        if (isInside) {
            if (radarPill) radarPill.classList.add('inside');
            if (radarTitle) radarTitle.innerText = '¡Estás en el punto! 🎯';
            if (radarSubtitle) radarSubtitle.innerText = `Check-in automático activado (${distanceLabel})`;
            if (hostStatus) {
                hostStatus.innerText = '📍 En el punto (Check-in ✅)';
                hostStatus.style.color = '#CCFF00';
            }

            if (!hasCelebratedArrival) {
                hasCelebratedArrival = true;
                if (typeof confetti === 'function') {
                    confetti({
                        particleCount: 70,
                        spread: 60,
                        origin: { y: 0.65 },
                        colors: ['#CCFF00', '#FFFFFF', '#25D366']
                    });
                }
                if (navigator.vibrate) {
                    try { navigator.vibrate([80, 50, 80]); } catch (e) {}
                }
            }
        } else {
            if (radarPill) radarPill.classList.remove('inside');
            if (radarTitle) radarTitle.innerText = `Punto a ${distanceLabel}`;
            if (radarSubtitle) radarSubtitle.innerText = `${etaLabel} · Perímetro ${GEOFENCE_RADIUS_METERS}m`;
            if (hostStatus) {
                hostStatus.innerText = `🏃 A ${distanceLabel} (${etaLabel})`;
                hostStatus.style.color = '#8A9590';
            }
        }

        if (userMarker) {
            userMarker.setLatLng(userCoords);
        }
        if (routePolyline) {
            routePolyline.setLatLngs([userCoords, targetCoords]);
        }
    }

    function toggleSimulateArrival() {
        isSimulatedArrival = !isSimulatedArrival;
        const simBtn = document.getElementById('btn-toggle-sim');
        if (isSimulatedArrival) {
            if (simBtn) simBtn.innerText = 'Restablecer GPS';
            updateGeofenceTelemetry([targetCoords[0] + 0.00003, targetCoords[1] + 0.00003]);
        } else {
            hasCelebratedArrival = false;
            if (simBtn) simBtn.innerText = 'Simular Llegada';
            updateGeofenceTelemetry([targetCoords[0] - 0.0016, targetCoords[1] - 0.0013]);
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const planTitleParam = urlParams.get('t');
        const planVibeParam = urlParams.get('v');
        const latParam = urlParams.get('lat');
        const lngParam = urlParams.get('lng');
        const seenWelcome = localStorage.getItem('planealo_onboarding_seen');
        const savedActivePlan = localStorage.getItem('planealo_active_plan');

        // Parseo de coordenadas prioritarias desde URL
        if (latParam && lngParam) {
            const pLat = parseFloat(latParam);
            const pLng = parseFloat(lngParam);
            if (!isNaN(pLat) && !isNaN(pLng)) {
                targetCoords = [pLat, pLng];
            }
        } else if (savedActivePlan) {
            try {
                const parsedPlan = JSON.parse(savedActivePlan);
                if (parsedPlan.lat && parsedPlan.lng) {
                    targetCoords = [Number(parsedPlan.lat), Number(parsedPlan.lng)];
                }
            } catch (e) {}
        }

        map = L.map('map-container', { zoomControl: false }).setView(targetCoords, 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // Geocerca 50m
        geofenceCircle = L.circle(targetCoords, {
            radius: GEOFENCE_RADIUS_METERS,
            color: '#CCFF00',
            fillColor: '#CCFF00',
            fillOpacity: 0.18,
            weight: 2
        }).addTo(map);

        // Marcador del punto de encuentro (Arrastrable e interactivo)
        const targetIcon = L.divIcon({
            className: 'custom-target-marker',
            html: '<div style="background:#CCFF00; color:#0A0C0B; font-weight:800; font-size:12px; padding:4px 8px; border-radius:12px; border:2px solid #FFFFFF; box-shadow:0 0 15px rgba(204,255,0,0.8); display:flex; align-items:center; gap:4px; cursor:move;">📍 Punto</div>',
            iconSize: [60, 26],
            iconAnchor: [30, 13]
        });
        targetMarker = L.marker(targetCoords, { icon: targetIcon, draggable: true }).addTo(map)
            .bindPopup('<b>Punto de Encuentro</b><br>Arrastra o toca el mapa para moverlo');

        targetMarker.on('dragend', e => {
            const pos = e.target.getLatLng();
            setTargetLocation(pos.lat, pos.lng, false);
        });

        // Interacción de toque/clic en el mapa para ubicar el punto
        map.on('click', e => {
            if (isSelectingLocationMode) {
                setTargetLocation(e.latlng.lat, e.latlng.lng, true);
            }
        });

        // Marcador del usuario
        const userIcon = L.divIcon({
            className: 'custom-user-marker',
            html: '<div style="width:16px; height:16px; border-radius:50%; background:#FFFFFF; border:3px solid #CCFF00; box-shadow:0 0 12px #CCFF00;"></div>',
            iconSize: [16, 16],
            iconAnchor: [8, 8]
        });
        userMarker = L.marker(userCoords, { icon: userIcon }).addTo(map)
            .bindPopup('Tu ubicación en vivo');

        // Línea de ruta recta
        routePolyline = L.polyline([userCoords, targetCoords], {
            color: '#CCFF00',
            weight: 2,
            dashArray: '6, 8',
            opacity: 0.85
        }).addTo(map);

        // Inicializar telemetría y etiquetas
        updateGeofenceTelemetry(userCoords);
        updateLocationLabels();

        // GPS Real watcher
        if ('geolocation' in navigator) {
            gpsWatcherId = navigator.geolocation.watchPosition(
                pos => {
                    if (!isSimulatedArrival) {
                        updateGeofenceTelemetry([pos.coords.latitude, pos.coords.longitude]);
                    }
                },
                err => {
                    console.log('GPS continuo opcional:', err.message);
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        }

        if (planTitleParam) {
            const decodedTitle = decodeURIComponent(planTitleParam);
            const decodedVibe = planVibeParam ? decodeURIComponent(planVibeParam) : '☕ Chill';

            currentPlanData = {
                title: decodedTitle,
                vibe: decodedVibe,
                lat: targetCoords[0],
                lng: targetCoords[1]
            };
            updateInviteScreen();
            
            document.getElementById('join-btn').style.display = 'block';
            switchView('view-invite');
        } else {
            if (savedActivePlan) {
                try {
                    currentPlanData = JSON.parse(savedActivePlan);
                    if (currentPlanData.lat && currentPlanData.lng) {
                        targetCoords = [Number(currentPlanData.lat), Number(currentPlanData.lng)];
                        setTargetLocation(targetCoords[0], targetCoords[1], true);
                    }
                } catch (e) {}
                showMapPlanPill(true);
            }

            if (seenWelcome) {
                switchView('view-map');
            } else {
                switchView('view-welcome');
            }
        }
    });

    function switchView(viewId) {
        document.querySelectorAll('.view, .solid-view').forEach(v => v.classList.remove('active'));
        const target = document.getElementById(viewId);
        if (target) {
            target.classList.add('active');
        }

        if (viewId === 'view-map') {
            setTimeout(() => { if(map) map.invalidateSize(); }, 300);
        }
    }

    function completeOnboarding() {
        localStorage.setItem('planealo_onboarding_seen', 'true');
        switchView('view-map');
    }

    function goToCreatePlan() {
        updateLocationLabels();
        switchView('view-create');
    }

    function selectVibe(element, vibeName, emoji) {
        document.querySelectorAll('.vibe-option-dark').forEach(el => el.classList.remove('selected'));
        element.classList.add('selected');
        selectedVibeText = `${emoji} ${vibeName}`;
    }

    function generateInvite() {
        const title = document.getElementById('plan-title').value || 'Plan en grupo';
        currentPlanData = {
            title: title,
            vibe: selectedVibeText,
            lat: targetCoords[0],
            lng: targetCoords[1]
        };

        localStorage.setItem('planealo_active_plan', JSON.stringify(currentPlanData));

        updateInviteScreen();
        showMapPlanPill(true);

        const domain = window.location.host || 'planealo-aqui.netlify.app';
        const encodedTitle = encodeURIComponent(title);
        const encodedVibe = encodeURIComponent(selectedVibeText);
        const lat = Number(targetCoords[0]).toFixed(5);
        const lng = Number(targetCoords[1]).toFixed(5);
        
        fullInviteUrl = `https://${domain}/?t=${encodedTitle}&v=${encodedVibe}&lat=${lat}&lng=${lng}`;
        document.getElementById('invite-url-text').innerText = fullInviteUrl;
        
        switchView('view-invite');
    }

    function updateInviteScreen() {
        document.getElementById('invite-subtitle').innerText = `Vibe: ${currentPlanData.vibe} · ${currentPlanData.title}`;
        document.getElementById('postal-title').innerText = currentPlanData.title;
        document.getElementById('postal-tagline').innerText = `✨ Vibe: ${currentPlanData.vibe}`;
        document.getElementById('participants-title').innerText = `Amigos en camino (${participantCount})`;
    }

    function showMapPlanPill(show) {
        const pill = document.getElementById('map-plan-pill');
        if (show) {
            document.getElementById('map-pill-title').innerText = currentPlanData.title;
            document.getElementById('map-pill-count').innerText = `${participantCount} en camino →`;
            pill.style.display = 'flex';
        } else {
            pill.style.display = 'none';
        }
    }

    function openActivePlan() {
        updateInviteScreen();
        const domain = window.location.host || 'planealo-aqui.netlify.app';
        const encodedTitle = encodeURIComponent(currentPlanData.title);
        const encodedVibe = encodeURIComponent(currentPlanData.vibe);
        const lat = Number(targetCoords[0]).toFixed(5);
        const lng = Number(targetCoords[1]).toFixed(5);
        fullInviteUrl = `https://${domain}/?t=${encodedTitle}&v=${encodedVibe}&lat=${lat}&lng=${lng}`;
        document.getElementById('invite-url-text').innerText = fullInviteUrl;
        document.getElementById('join-btn').style.display = 'none';
        switchView('view-invite');
    }

    function joinAsGuest() {
        participantCount = 4;
        document.getElementById('status-sofia').innerText = '✅ ¡Ya vas en camino!';
        document.getElementById('status-sofia').style.color = '#CCFF00';
        document.getElementById('join-btn').innerText = '¡Conectado al Plan! 🚀';
        document.getElementById('join-btn').disabled = true;
        document.getElementById('join-btn').style.opacity = '0.7';
        
        document.getElementById('participants-title').innerText = `Amigos en camino (${participantCount})`;
        document.getElementById('map-pill-count').innerText = `${participantCount} en camino →`;
    }

    function finishPlanAndCapture() {
        localStorage.removeItem('planealo_active_plan');
        showMapPlanPill(false);
        updateInviteScreen();
        switchView('view-memory');
    }

    function copyInviteLink() {
        navigator.clipboard.writeText(fullInviteUrl).then(() => {
            alert('¡Enlace copiado al portapapeles!');
        }).catch(() => {
            alert('Enlace listo.');
        });
    }

    function shareOnWhatsApp() {
        const message = encodeURIComponent(`¡Únete a Planealo Aquí! Coordinemos el punto de encuentro aquí: ${fullInviteUrl}`);
        window.open(`https://api.whatsapp.com/send?text=${message}`, '_blank');
    }

    function goToMemory() {
        updateInviteScreen();
        switchView('view-memory');
    }

    function handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById('uploaded-photo');
                img.src = e.target.result;
                img.style.display = 'block';
                document.getElementById('camera-icon-placeholder').style.display = 'none';
            }
            reader.readAsDataURL(file);
        }
    }

    function setMemoryStyle(style, element) {
        currentStyle = style;
        document.querySelectorAll('.style-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');

        const quoteBox = document.getElementById('memory-quote');
        if (style === 'postal') {
            quoteBox.innerText = '“Un espacio libre de ruido para conectar de verdad.”';
        } else if (style === 'collage') {
            quoteBox.innerText = '📸 Colección de momentos épicos en grupo.';
        } else if (style === 'meme') {
            quoteBox.innerText = '🤪 Misión cumplida: Sobrevivimos al plan sin perdernos.';
        }
    }

    function drawRoundedRect(ctx, x, y, width, height, radius) {
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + width - radius, y);
        ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
        ctx.lineTo(x + width, y + height - radius);
        ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
        ctx.lineTo(x + radius, y + height);
        ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
        ctx.lineTo(x, y + radius);
        ctx.quadraticCurveTo(x, y, x + radius, y);
        ctx.closePath();
    }

    function wrapText(ctx, text, x, y, maxWidth, lineHeight) {
        const words = text.split(' ');
        let line = '';
        for (let n = 0; n < words.length; n++) {
            const testLine = line + words[n] + ' ';
            const metrics = ctx.measureText(testLine);
            const testWidth = metrics.width;
            if (testWidth > maxWidth && n > 0) {
                ctx.fillText(line, x, y);
                line = words[n] + ' ';
                y += lineHeight;
            } else {
                line = testLine;
            }
        }
        ctx.fillText(line, x, y);
    }

    async function generateMemoryCanvas() {
        const canvas = document.createElement('canvas');
        canvas.width = 1080;
        canvas.height = 1350;
        const ctx = canvas.getContext('2d');
        if (!ctx) return null;

        const isPostal = currentStyle === 'postal';
        const isMeme = currentStyle === 'meme';

        // 1. Fondo Dark Pro
        const bgGrad = ctx.createLinearGradient(0, 0, 0, 1350);
        bgGrad.addColorStop(0, '#111513');
        bgGrad.addColorStop(1, '#050706');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, 1080, 1350);

        // Grid sutil
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
        ctx.lineWidth = 1;
        for (let x = 0; x < 1080; x += 60) {
            ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, 1350); ctx.stroke();
        }
        for (let y = 0; y < 1350; y += 60) {
            ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(1080, y); ctx.stroke();
        }

        // 2. Tarjeta Glassmorphic
        const cardX = 70;
        const cardY = 80;
        const cardW = 940;
        const cardH = 1190;
        const cardRadius = 36;

        ctx.save();
        ctx.shadowColor = 'rgba(0, 0, 0, 0.65)';
        ctx.shadowBlur = 50;
        ctx.shadowOffsetY = 25;
        drawRoundedRect(ctx, cardX, cardY, cardW, cardH, cardRadius);
        ctx.fillStyle = '#161A18';
        ctx.fill();
        ctx.restore();

        ctx.strokeStyle = isMeme ? '#FF0055' : 'rgba(204, 255, 0, 0.35)';
        ctx.lineWidth = 2;
        drawRoundedRect(ctx, cardX, cardY, cardW, cardH, cardRadius);
        ctx.stroke();

        // 3. Encabezado de Marca
        ctx.fillStyle = '#FFFFFF';
        ctx.font = '800 32px "Plus Jakarta Sans", sans-serif';
        ctx.fillText('PLANEALO AQUÍ', cardX + 45, cardY + 70);

        ctx.fillStyle = '#CCFF00';
        ctx.font = '800 24px "Plus Jakarta Sans", sans-serif';
        ctx.fillText('⚡ ENCUENTRO OFICIAL', cardX + 45, cardY + 105);

        // 4. Matasellos Geográfico
        const stampX = cardX + cardW - 130;
        const stampY = cardY + 75;
        ctx.strokeStyle = '#CCFF00';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(stampX, stampY, 44, 0, Math.PI * 2);
        ctx.stroke();

        ctx.font = '800 11px "Plus Jakarta Sans", sans-serif';
        ctx.fillStyle = '#CCFF00';
        ctx.textAlign = 'center';
        ctx.fillText('CHECK-IN ✅', stampX, stampY - 8);
        ctx.fillText('50M GEOFENCE', stampX, stampY + 8);
        ctx.fillText('VERIFIED', stampX, stampY + 22);
        ctx.textAlign = 'left';

        // 5. Fotografía o Selfie
        const imgBoxX = cardX + 45;
        const imgBoxY = cardY + 145;
        const imgBoxW = cardW - 90;
        const imgBoxH = 560;
        const imgRadius = 24;

        const uploadedImg = document.getElementById('uploaded-photo');
        const hasPhoto = uploadedImg && uploadedImg.src && uploadedImg.style.display !== 'none';

        ctx.save();
        drawRoundedRect(ctx, imgBoxX, imgBoxY, imgBoxW, imgBoxH, imgRadius);
        ctx.clip();

        if (hasPhoto) {
            ctx.drawImage(uploadedImg, imgBoxX, imgBoxY, imgBoxW, imgBoxH);
        } else {
            const photoGrad = ctx.createLinearGradient(imgBoxX, imgBoxY, imgBoxX + imgBoxW, imgBoxY + imgBoxH);
            photoGrad.addColorStop(0, '#1E2421');
            photoGrad.addColorStop(1, '#111513');
            ctx.fillStyle = photoGrad;
            ctx.fillRect(imgBoxX, imgBoxY, imgBoxW, imgBoxH);

            ctx.fillStyle = '#CCFF00';
            ctx.font = '72px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('📸', imgBoxX + imgBoxW / 2, imgBoxY + imgBoxH / 2 - 10);

            ctx.fillStyle = '#FFFFFF';
            ctx.font = '700 24px "Plus Jakarta Sans", sans-serif';
            ctx.fillText('Experiencia Vivida en Grupo', imgBoxX + imgBoxW / 2, imgBoxY + imgBoxH / 2 + 50);

            ctx.fillStyle = '#8A9590';
            ctx.font = '500 18px "Plus Jakarta Sans", sans-serif';
            ctx.fillText('Conexión real sin distracciones', imgBoxX + imgBoxW / 2, imgBoxY + imgBoxH / 2 + 82);
            ctx.textAlign = 'left';
        }
        ctx.restore();

        // 6. Información del Plan
        const infoY = imgBoxY + imgBoxH + 45;

        ctx.fillStyle = '#CCFF00';
        ctx.font = '800 20px "Plus Jakarta Sans", sans-serif';
        ctx.fillText(`VIBE ${currentPlanData.vibe.toUpperCase()}`, cardX + 45, infoY);

        ctx.fillStyle = '#FFFFFF';
        ctx.font = '800 42px "Plus Jakarta Sans", sans-serif';
        const displayTitle = currentPlanData.title || 'Café y estudio';
        wrapText(ctx, displayTitle, cardX + 45, infoY + 48, cardW - 90, 48);

        // 7. Cita Filosófica
        const quoteBoxY = infoY + 120;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.04)';
        drawRoundedRect(ctx, cardX + 45, quoteBoxY, cardW - 90, 85, 16);
        ctx.fill();

        ctx.fillStyle = '#FFFFFF';
        ctx.font = '600 20px "Plus Jakarta Sans", sans-serif';
        const quoteText = document.getElementById('memory-quote').innerText;
        wrapText(ctx, quoteText, cardX + 70, quoteBoxY + 36, cardW - 140, 26);

        ctx.fillStyle = '#CCFF00';
        ctx.font = '800 18px "Plus Jakarta Sans", sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText('@amabo', cardX + cardW - 70, quoteBoxY + 68);
        ctx.textAlign = 'left';

        // 8. Participantes
        const crewY = quoteBoxY + 115;
        ctx.fillStyle = '#8A9590';
        ctx.font = '700 16px "Plus Jakarta Sans", sans-serif';
        ctx.fillText('CONFIRMADOS EN EL PUNTO:', cardX + 45, crewY);

        const attendees = ['Tú (Host)', 'Sofía R.', 'Mateo V.'];
        let currentBadgeX = cardX + 45;
        const badgeY = crewY + 12;

        attendees.forEach(name => {
            ctx.font = '700 16px "Plus Jakarta Sans", sans-serif';
            const textWidth = ctx.measureText(name).width;
            const badgeW = textWidth + 30;

            ctx.fillStyle = 'rgba(204, 255, 0, 0.12)';
            drawRoundedRect(ctx, currentBadgeX, badgeY, badgeW, 36, 12);
            ctx.fill();

            ctx.fillStyle = '#CCFF00';
            ctx.fillText(name, currentBadgeX + 15, badgeY + 24);

            currentBadgeX += badgeW + 14;
        });

        // 9. Pie
        ctx.fillStyle = '#5A635E';
        ctx.font = '600 15px "Plus Jakarta Sans", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Experiencia coordinada en vivo con Planealo Aquí ⚡ · planealo-aqui.netlify.app', 1080 / 2, 1275);

        return canvas;
    }

    async function saveMemoryAsImage() {
        const canvas = await generateMemoryCanvas();
        if (!canvas) return;
        const dataUrl = canvas.toDataURL('image/png');
        const slug = (currentPlanData.title || 'recuerdo').toLowerCase().replace(/[^a-z0-9]+/g, '-');
        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = `planealo-recuerdo-${slug}.png`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        alert('¡Recuerdo descargado como imagen PNG de alta calidad!');
    }

    async function shareMemory() {
        const canvas = await generateMemoryCanvas();
        if (!canvas) return;

        canvas.toBlob(async (blob) => {
            if (!blob) return;
            const slug = (currentPlanData.title || 'recuerdo').toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const file = new File([blob], `recuerdo-${slug}.png`, { type: 'image/png' });

            if (navigator.canShare && navigator.canShare({ files: [file] })) {
                try {
                    await navigator.share({
                        title: `Recuerdo: ${currentPlanData.title}`,
                        text: `¡Mira nuestro recuerdo de "${currentPlanData.title}" en Planealo Aquí! ⚡\n— @amabo`,
                        files: [file]
                    });
                } catch (e) {}
            } else if (navigator.share) {
                try {
                    await navigator.share({
                        title: `Recuerdo: ${currentPlanData.title}`,
                        text: `¡Mira nuestro recuerdo de "${currentPlanData.title}" en Planealo Aquí! ⚡\n— @amabo`,
                        url: window.location.origin
                    });
                } catch (e) {}
            } else {
                saveMemoryAsImage();
            }
        }, 'image/png');
    }
</script>

