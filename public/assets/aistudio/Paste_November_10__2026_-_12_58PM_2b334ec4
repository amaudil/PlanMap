<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Planealo Aquí - Experiencias Compartidas</title>
    <!-- PWA Config -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#CCFF00">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <!-- Tipografía moderna -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Leaflet.js para el mapa base -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <!-- Confetti para celebración de geocerca -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>
    
    <style>
        :root {
            --bg-dark: #0A0C0B;
            --card-dark: #161A18;
            --card-border: rgba(255, 255, 255, 0.08);
            --text-white: #FFFFFF;
            --text-gray: #8A9590;
            --accent-neon: #CCFF00;
            --accent-neon-hover: #B5E600;
            --accent-whatsapp: #25D366;
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; -webkit-tap-highlight-color: transparent; }
        
        body {
            background-color: #030404;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100dvh;
            width: 100vw;
            color: var(--text-white);
            overflow: hidden;
        }

        #app {
            background-color: var(--bg-dark);
            width: 100%;
            max-width: 410px;
            height: 100dvh;
            max-height: 850px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
        }

        @media (min-width: 480px) {
            #app {
                border-radius: 44px;
                height: 840px;
                border: 2px solid rgba(255,255,255,0.08);
            }
        }

        .view {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            display: none;
            flex-direction: column;
            z-index: 1;
        }
        .view.active { display: flex; }

        /* VISTA 0: BIENVENIDA */
        #view-welcome {
            padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)) 20px;
            justify-content: space-between;
            background: linear-gradient(180deg, #111513 0%, #0A0C0B 100%);
            overflow-y: auto;
        }
        .welcome-hero-card {
            width: 100%;
            height: 300px;
            min-height: 250px;
            background: var(--card-dark);
            border-radius: 28px;
            overflow: hidden;
            position: relative;
            border: 1px solid var(--card-border);
            box-shadow: 0 16px 32px rgba(0,0,0,0.4);
            flex-shrink: 0;
        }
        .welcome-hero-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.85) contrast(1.05);
        }
        .hero-gradient-overlay {
            position: absolute;
            bottom: 0; left: 0; width: 100%; height: 50%;
            background: linear-gradient(to top, rgba(22, 26, 24, 0.9), transparent);
        }
        .welcome-title {
            font-size: clamp(1.8rem, 5vw, 2.2rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.6px;
            margin-top: 16px;
            color: var(--text-white);
        }
        .welcome-subtitle {
            font-size: 0.9rem;
            color: var(--text-gray);
            margin-top: 8px;
            line-height: 1.4;
        }

        /* COMPONENTES GENERALES DARK PRO */
        .btn-neon {
            background-color: var(--accent-neon);
            color: #0A0C0B;
            width: 100%;
            padding: 16px;
            border-radius: 22px;
            font-size: 1.05rem;
            font-weight: 800;
            border: none;
            cursor: pointer;
            text-align: center;
            box-shadow: 0 10px 30px rgba(204, 255, 0, 0.25);
            transition: transform 0.15s ease, background-color 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-neon:active { transform: scale(0.97); }

        .btn-whatsapp {
            background-color: var(--accent-whatsapp);
            color: #FFFFFF;
            width: 100%;
            padding: 14px;
            border-radius: 18px;
            font-size: 0.95rem;
            font-weight: 800;
            border: none;
            cursor: pointer;
            text-align: center;
            box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
            transition: transform 0.15s ease;
        }
        .btn-whatsapp:active { transform: scale(0.97); }

        /* VISTA 1: MAPA VIVO Y CENTRO DE MANDO */
        #map-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 1;
            filter: invert(100%) hue-rotate(180deg) brightness(88%) contrast(92%);
        }

        .map-overlay-top {
            position: absolute;
            top: 0; left: 0; width: 100%;
            padding: max(20px, env(safe-area-inset-top)) 20px 20px 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 10;
            pointer-events: none;
        }
        .map-overlay-top > * { pointer-events: auto; }

        .top-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }

        .brand-pill-dark {
            background: rgba(22, 26, 24, 0.85);
            backdrop-filter: blur(16px);
            padding: 10px 18px;
            border-radius: 30px;
            font-weight: 800;
            font-size: 1rem;
            color: var(--text-white);
            border: 1px solid var(--card-border);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }

        .active-plan-pill {
            background: rgba(22, 26, 24, 0.9);
            backdrop-filter: blur(16px);
            padding: 12px 18px;
            border-radius: 20px;
            border: 1px solid var(--accent-neon);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            transition: transform 0.15s ease;
        }
        .active-plan-pill:active { transform: scale(0.98); }

        /* Radar de Geocerca GPS en Vivo */
        .radar-pill {
            background: rgba(22, 26, 24, 0.94);
            backdrop-filter: blur(16px);
            padding: 10px 14px;
            border-radius: 18px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            font-size: 0.8rem;
            transition: all 0.25s ease;
        }
        .radar-pill.inside {
            border-color: #CCFF00;
            background: rgba(22, 26, 24, 0.98);
            box-shadow: 0 0 25px rgba(204, 255, 0, 0.3);
        }
        .radar-pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #CCFF00;
            box-shadow: 0 0 8px #CCFF00;
            flex-shrink: 0;
            animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(1.3); }
        }
        .radar-btn-sim {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #FFFFFF;
            padding: 4px 8px;
            border-radius: 8px;
            font-size: 0.72rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .radar-btn-sim:hover {
            background: rgba(204, 255, 0, 0.15);
            border-color: #CCFF00;
            color: #CCFF00;
        }

        /* Selector dinámico de ubicación */
        .btn-location-action {
            flex: 1;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: var(--text-white);
            padding: 9px 12px;
            border-radius: 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .btn-location-action:hover, .btn-location-action:active {
            background: rgba(204, 255, 0, 0.12);
            border-color: var(--accent-neon);
            color: var(--accent-neon);
        }
        .selector-banner {
            background: rgba(22, 26, 24, 0.96);
            backdrop-filter: blur(16px);
            border: 1px solid var(--accent-neon);
            padding: 12px 14px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .icon-btn-dark {
            width: 46px; height: 46px;
            background: rgba(22, 26, 24, 0.85);
            backdrop-filter: blur(16px);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            border: 1px solid var(--card-border);
            color: var(--text-white);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            flex-shrink: 0;
        }

        .map-overlay-bottom {
            position: absolute;
            bottom: max(25px, env(safe-area-inset-bottom)); left: 0; width: 100%;
            padding: 0 20px;
            z-index: 10;
        }

        .action-pill-neon {
            background: var(--accent-neon);
            color: #0A0C0B;
            border-radius: 32px;
            padding: 16px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            box-shadow: 0 14px 35px rgba(204, 255, 0, 0.35);
            font-weight: 800;
            font-size: 1.05rem;
            transition: transform 0.15s ease;
        }
        .action-pill-neon:active { transform: scale(0.97); }
        .action-arrow-dark {
            width: 36px; height: 36px; background: rgba(10, 12, 11, 0.12); border-radius: 50%;
            display: flex; align-items: center; justify-content: center; font-size: 1rem;
        }

        /* VISTAS INTERNAS */
        .solid-view {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: var(--bg-dark);
            z-index: 20;
            padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom)) 20px;
            display: none;
            flex-direction: column;
            overflow-y: auto;
        }
        .solid-view.active { display: flex; }

        h1 { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.5px; margin-bottom: 6px; }
        .subtitle { font-size: 0.9rem; color: var(--text-gray); margin-bottom: 20px; }

        .input-dark {
            width: 100%;
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            padding: 15px 18px;
            border-radius: 16px;
            color: var(--text-white);
            font-size: 1rem;
            font-weight: 600;
            outline: none;
            transition: border-color 0.2s ease;
        }
        .input-dark:focus { border-color: var(--accent-neon); }

        .vibe-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 16px;
        }
        .vibe-option-dark {
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 16px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
        }
        .vibe-option-dark.selected {
            border-color: var(--accent-neon);
            background: rgba(204, 255, 0, 0.05);
            box-shadow: 0 0 20px rgba(204, 255, 0, 0.15);
        }
        .vibe-emoji { font-size: 1.8rem; margin-bottom: 6px; }
        .vibe-name { font-size: 0.9rem; font-weight: 700; color: var(--text-white); }

        .card-dark {
            background: var(--card-dark);
            border-radius: 20px;
            padding: 18px;
            border: 1px solid var(--card-border);
            margin-bottom: 16px;
        }

        .postal-card-dark {
            background: linear-gradient(135deg, #161A18 0%, #0D100F 100%);
            border-radius: 24px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            margin-bottom: 16px;
            display: flex;
            flex-direction: column;
        }
        .postal-img-container {
            width: 100%;
            height: 190px;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 14px;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.3);
            cursor: pointer;
            position: relative;
        }
        .postal-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

        .style-selector {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
        }
        .style-btn {
            flex: 1; padding: 10px 6px; background: var(--card-dark); border: 1px solid var(--card-border); border-radius: 14px; color: var(--text-gray); font-size: 0.8rem; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.2s;
        }
        .style-btn.active { border-color: var(--accent-neon); color: var(--accent-neon); background: rgba(204,255,0,0.05); }

        .view-footer {
            margin-top: auto;
            padding-top: 10px;
        }
    </style>
</head>
<body>

<div id="app">
    <!-- VISTA 0: BIENVENIDA -->
    <div id="view-welcome" class="view">
        <div>
            <div class="welcome-hero-card">
                <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=800&q=80" alt="Experiencia compartida" class="welcome-hero-img">
                <div class="hero-gradient-overlay"></div>
            </div>
            <h1 class="welcome-title">Conecta sin ruido, vive el momento.</h1>
            <p class="welcome-subtitle">Organiza planes al instante, reúne a tu gente y conserva recuerdos significativos.</p>
        </div>
        
        <div style="margin-top: 20px;">
            <button class="btn-neon" onclick="completeOnboarding()">Comenzar</button>
            <p style="text-align: center; font-size: 0.85rem; color: var(--text-gray); margin-top: 12px;">¿Ya tienes cuenta? <span style="color: var(--text-white); font-weight: 700; cursor: pointer;">Iniciar sesión</span></p>
        </div>
    </div>

    <!-- VISTA 1: MAPA VIVO Y CENTRO DE MANDO -->
    <div id="view-map" class="view">
        <div id="map-container"></div>

        <div class="map-overlay-top">
            <div class="top-row">
                <div class="brand-pill-dark">Planealo Aquí ⚡</div>
                <button class="icon-btn-dark" onclick="goToMemory()">📸</button>
            </div>

            <!-- Banner interactivo de selección de punto en mapa -->
            <div class="selector-banner" id="map-selection-banner" style="display: none;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-size: 0.75rem; color: var(--accent-neon); font-weight: 800; display: flex; align-items: center; gap: 6px;">
                        <span class="radar-pulse-dot" style="background:#CCFF00; box-shadow:0 0 8px #CCFF00;"></span>
                        SELECCIONA EL ENCUENTRO
                    </span>
                    <button onclick="cancelLocationSelection()" style="background:none; border:none; color:var(--text-gray); font-size:0.75rem; font-weight:700; cursor:pointer;">✕ Volver</button>
                </div>
                <p style="font-size: 0.78rem; color: var(--text-white); margin: 0;">
                    Toca cualquier punto del mapa para mover el pin o arrástralo libremente.
                </p>
                <div style="display: flex; gap: 6px; align-items: center;">
                    <span id="selected-coords-pill" style="font-size: 0.72rem; color: var(--text-gray); background: rgba(255,255,255,0.06); padding: 5px 8px; border-radius: 8px; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        📍 8.9824, -79.5199
                    </span>
                    <button class="radar-btn-sim" style="background:var(--accent-neon); color:#0A0C0B; border:none; padding:5px 12px; font-weight:800;" onclick="confirmLocationSelection()">
                        Confirmar Punto ✅
                    </button>
                </div>
            </div>

            <!-- Radar de Geocerca GPS en Vivo -->
            <div class="radar-pill" id="geofence-radar-pill">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div class="radar-pulse-dot" id="radar-indicator"></div>
                    <div>
                        <div style="font-weight: 800; color: #FFFFFF;" id="radar-title">Punto a 210 m</div>
                        <div style="font-size: 0.7rem; color: #8E9290;" id="radar-subtitle">~3 min a pie · Perímetro 50m</div>
                    </div>
                </div>
                <button class="radar-btn-sim" id="btn-toggle-sim" onclick="toggleSimulateArrival()">Simular Llegada</button>
            </div>

            <div class="active-plan-pill" id="map-plan-pill" onclick="openActivePlan()" style="display: none;">
                <div>
                    <span style="font-size: 0.75rem; color: var(--accent-neon); font-weight: 800; display: block;">⚡ PLAN ACTIVO</span>
                    <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-white);" id="map-pill-title">Café en Casco</span>
                </div>
                <span style="font-size: 0.85rem; background: rgba(204,255,0,0.15); color: var(--accent-neon); padding: 4px 10px; border-radius: 12px; font-weight: 800;" id="map-pill-count">3 en camino →</span>
            </div>
        </div>

        <div class="map-overlay-bottom">
            <div class="action-pill-neon" onclick="goToCreatePlan()">
                <span>¿Cuál es el plan hoy?</span>
                <div class="action-arrow-dark">→</div>
            </div>
        </div>
    </div>

    <!-- VISTA 2: CREAR PLAN -->
    <div id="view-create" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Cancelar</h3>
            <span style="font-weight: 800; color: var(--accent-neon); font-size: 0.9rem;">Paso 1 de 2</span>
        </div>
        <h1>Nuevo Plan</h1>
        <p class="subtitle">Define la vibra y el propósito del encuentro.</p>

        <div style="margin-bottom: 16px;">
            <label style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 6px; color: var(--text-white);">¿Qué van a hacer?</label>
            <input type="text" id="plan-title" class="input-dark" value="Café y estudio">
        </div>

        <label style="font-size: 0.85rem; font-weight: 700; display: block; margin-bottom: 10px; color: var(--text-white);">Selecciona la Vibe</label>
        <div class="vibe-grid">
            <div class="vibe-option-dark selected" onclick="selectVibe(this, 'Chill', '☕')">
                <div class="vibe-emoji">☕</div>
                <div class="vibe-name">Chill</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Energía', '👟')">
                <div class="vibe-emoji">👟</div>
                <div class="vibe-name">Energía</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Aire libre', '🌳')">
                <div class="vibe-emoji">🌳</div>
                <div class="vibe-name">Aire libre</div>
            </div>
            <div class="vibe-option-dark" onclick="selectVibe(this, 'Nocturno', '🌙')">
                <div class="vibe-emoji">🌙</div>
                <div class="vibe-name">Nocturno</div>
            </div>
        </div>

        <!-- Selector dinámico de Punto de Encuentro -->
        <div class="card-dark" style="margin-top: 14px; margin-bottom: 16px; border: 1px solid var(--card-border);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label style="font-size: 0.85rem; font-weight: 700; color: var(--text-white); margin-bottom: 0;">📍 Punto de Encuentro</label>
                <span id="create-coords-badge" style="font-size: 0.72rem; color: var(--accent-neon); background: rgba(204,255,0,0.12); padding: 2px 8px; border-radius: 8px; font-weight: 800;">8.9824, -79.5199</span>
            </div>
            <p style="font-size: 0.78rem; color: var(--text-gray); margin-bottom: 10px;" id="create-location-desc">
                Punto geográfico donde se activará la geocerca de 50 metros.
            </p>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="btn-location-action" onclick="startPickingLocationOnMap()">
                    🗺️ Mover en Mapa
                </button>
                <button type="button" class="btn-location-action" onclick="useCurrentLocationAsTarget()">
                    🎯 Mi GPS Aquí
                </button>
            </div>
        </div>

        <div class="view-footer">
            <button class="btn-neon" onclick="generateInvite()">Armar enlace de invitación</button>
        </div>
    </div>

    <!-- VISTA 3: SALA DE INVITACIÓN / CENTRO DE CONTROL -->
    <div id="view-invite" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Volver al Mapa</h3>
            <span style="font-size: 0.85rem; background: rgba(204,255,0,0.1); color: var(--accent-neon); padding: 6px 12px; border-radius: 12px; font-weight: 800;">Plan Activo</span>
        </div>
        <h1>¡Plan listo para rodar! 🔥</h1>
        <p class="subtitle" id="invite-subtitle">Vibe: ☕ Chill</p>

        <div class="card-dark" style="text-align: center; border: 2px dashed var(--accent-neon);">
            <p style="font-size: 0.85rem; color: var(--text-gray); margin-bottom: 6px;">Enlace rápido para compartir</p>
