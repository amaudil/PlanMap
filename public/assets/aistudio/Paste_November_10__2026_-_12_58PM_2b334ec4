            <p style="font-size: 0.75rem; color: var(--text-gray); margin-top: 4px;">Panamá · 6 de Noviembre, 2026</p>
        </div>

        <div class="card-dark" style="padding: 12px; text-align: center;">
            <p style="font-size: 0.8rem; font-style: italic; color: var(--text-gray);" id="memory-quote">“Un espacio libre de ruido para conectar de verdad.”</p>
        </div>

        <div class="view-footer" style="display: flex; gap: 10px;">
            <button class="input-dark" style="flex: 1; text-align: center; cursor: pointer; font-weight: 700; background: var(--card-dark);" onclick="saveMemoryAsImage()">Guardar 💾</button>
            <button class="btn-neon" style="flex: 1; margin-top: 0;" onclick="shareMemory()">Compartir 🚀</button>
