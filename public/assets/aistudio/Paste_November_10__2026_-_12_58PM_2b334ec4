    <!-- VISTA 4: RECUERDO / POSTAL & SELFIE COLECTIVA -->
    <div id="view-memory" class="solid-view">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="cursor: pointer; font-size: 0.95rem; color: var(--text-gray);" onclick="switchView('view-map')">← Volver al Mapa</h3>
            <span style="font-weight: 800; color: var(--accent-neon);">Recuerdo Colectivo 📸</span>
